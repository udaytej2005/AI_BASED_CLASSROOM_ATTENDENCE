# ==========================================================================
# Smart Classroom Attendance - environment template
#
# Copy this file to backend/.env and edit the values. NEVER commit a real .env.
# Every value below is a PLACEHOLDER. Replace secrets before any real use.
# ==========================================================================

# "development" | "test" | "production"
APP_ENV=development

# PostgreSQL (intended database). Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# The password below is a placeholder and is rejected when APP_ENV=production.
DATABASE_URL=postgresql+psycopg://attendance:change-me@localhost:5432/attendance

# SQLite fallback (only if PostgreSQL cannot run; see docs/installation-and-troubleshooting.md):
# DATABASE_URL=sqlite:///./data/attendance.db

# Institutional timezone (IANA name). Timetable times are interpreted in this zone.
TIMEZONE=Asia/Kolkata

# Comma-separated browser origins allowed to call the API directly (the Vite dev server proxies /api,
# so this is only needed if you call the API from another origin).
CORS_ORIGINS=http://localhost:5173

# Signing key for session tokens (added in Phase 2). Generate a long random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value-before-deployment

# Maximum accepted request body size in bytes (default 10 MiB).
MAX_REQUEST_BYTES=10485760

# ---- Face recognition (Phase 4). Defaults are used when these are not set. Values are not validated. ----
# Model files are installed by scripts/fetch_face_models.sh into the repository's models/ folder (git-ignored).
# FACE_MATCH_THRESHOLD=0.363
# FACE_MATCH_MARGIN=0.05
# FACE_RECOGNIZE_EVERY_FRAMES=10
# FACE_PROCESS_EVERY_FRAMES=3
# TEMPORAL_MIN_OBSERVATIONS=5
# TEMPORAL_MIN_SPAN_SECONDS=2.0
# TEMPORAL_MIN_GAP_SECONDS=0.4
# BIOMETRIC_RETENTION_DAYS=365
# MAX_VIDEO_UPLOAD_BYTES=104857600
# Camera sources are NOT set here. A camera's stream_reference names an environment variable, for example:
# CAM_R101_URL=rtsp://user:change-me@192.168.1.50/stream   (placeholder: never commit a real address)

